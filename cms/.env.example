
# Server
HOST=0.0.0.0
PORT=1337

# Secrets — generate your own for any real deployment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=replace-me-1,replace-me-2,replace-me-3,replace-me-4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
ENCRYPTION_KEY=replace-me

# Database
# DATABASE_CLIENT=sqlite for local `npm run develop` without Docker.
# DATABASE_CLIENT=postgres when running via docker-compose.
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=freelinx
DATABASE_USERNAME=freelinx
DATABASE_PASSWORD=freelinx
DATABASE_SSL=false
DATABASE_FILENAME=.tmp/data.db

# Frontend URL allowed to read the public API (CORS)
FRONTEND_URL=http://localhost:3000
